{
  "name": "openjob-api-v1",
  "version": "1.0.0",
  "private": true,
  "author":"rnlkav",
  "description": "OpenJob RESTful API with Express and PostgreSQL",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "start:dev": "node --watch src/server.js",
    "db:create": "node ./script/create-db.js",
